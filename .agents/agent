#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
AGENTS_DIR="$(dirname "$SCRIPT_PATH")"
RUNS_DIR="$AGENTS_DIR/runs"

die() {
  printf 'agent: %s\n' "$*" >&2
  exit 1
}

source "$AGENTS_DIR/lib/runtime.sh"
source "$AGENTS_DIR/lib/hosts.sh"
source "$AGENTS_DIR/lib/worktree.sh"
source "$AGENTS_DIR/lib/self-test.sh"

usage() {
  cat <<'EOF'
Usage:
  .agents/agent explorer "task"
  .agents/agent planner "task"
  .agents/agent worker "task"
  .agents/agent heavy_worker "task"
  .agents/agent reviewer RUN_ID
  .agents/agent followup RUN_ID "task"
  .agents/agent diff RUN_ID
  .agents/agent apply RUN_ID
  .agents/agent clean RUN_ID
  .agents/agent self-test

Environment:
  AGENT_HOST=codex|claude|agy|opencode
  AGENT_REVIEW_MODEL=9r-sol
  OPENCODE_9ROUTER_PROVIDER=9router
  AGENT_WORKTREE_ROOT=/custom/worktree/root
EOF
}

main() {
  require_command git
  local command=${1:-}
  case $command in
    -h|--help|help|'') ;;
    self-test)
      check_installation_visibility strict || die "fix ignored kit files before running self-test"
      ;;
    *)
      check_installation_visibility warn
      ;;
  esac
  case $command in
    explorer|planner|worker|heavy_worker)
      shift
      (($#)) || die "$command requires a task"
      run_role "$command" "$*"
      ;;
    reviewer)
      [[ $# == 2 ]] || die "reviewer requires exactly one RUN_ID"
      run_reviewer "$2"
      ;;
    followup)
      [[ $# -ge 3 ]] || die "followup requires RUN_ID and task"
      run_followup "$2" "${*:3}"
      ;;
    diff)
      [[ $# == 2 ]] || die "diff requires exactly one RUN_ID"
      show_diff "$2"
      ;;
    apply)
      [[ $# == 2 ]] || die "apply requires exactly one RUN_ID"
      apply_run "$2"
      ;;
    clean)
      [[ $# == 2 ]] || die "clean requires exactly one RUN_ID"
      clean_run "$2"
      ;;
    self-test)
      [[ $# == 1 ]] || die "self-test takes no arguments"
      self_test
      ;;
    -h|--help|help|'')
      usage
      ;;
    *)
      usage >&2
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
